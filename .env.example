# Redis
REDIS_URL=redis://localhost:6379/0

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=compraventa
DB_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/compraventa

# Scraper
PROXY_URL=
SCRAPER_MODE=category
SEARCH_TERMS=sony wh-1000xm4,airpods pro,nintendo switch
