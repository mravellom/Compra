# Redis
REDIS_URL=redis://localhost:6379/0

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=compraventa
DB_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/compraventa

# Scraper
# Proxies: comma-separated list. Required for eBay + AliExpress.
# Residential proxies recommended (datacenter IPs get blocked).
# Providers: Bright Data, Oxylabs, SmartProxy, IPRoyal
# Format: http://user:pass@host:port
# Example: PROXY_URLS=http://user:pass@gate.smartproxy.com:7000,http://user:pass@brd.superproxy.io:22225
PROXY_URLS=
PROXY_URL=
SCRAPER_MODE=orchestrated          # orchestrated (default), category, search
SEARCH_TERMS=sony wh-1000xm4,airpods pro,nintendo switch
SCRAPE_INTERVAL=300
MAX_RESULTS=20
CATEGORIES=                        # empty = auto-detect common categories
CATEGORY_MAX_PAGES=15              # base pages per category (prioritizer adjusts dynamically)

# Orchestrator mode weights (must sum to 1.0)
WEIGHT_CATEGORY=0.60               # Category crawling share
WEIGHT_SEARCH=0.25                 # Keyword search share
WEIGHT_TRENDING=0.15               # Trending/bestseller share

# Subcategory discovery
SUBCATEGORY_DISCOVERY=true         # Auto-discover subcategories from category pages
SUBCATEGORY_MAX_PAGES=5            # Pages per discovered subcategory

# Search expansion
SEARCH_MAX_RESULTS=30              # Results per expanded search term

# Trending
TRENDING_MAX_PAGES=2               # Pages per trending section

# Smart expansion (category-only mode)
SMART_EXPANSION=true
EXPANSION_MULTIPLIER=1.5

# Category prioritization stats persistence
CATEGORY_STATS_FILE=               # empty = default (scraper/.category_stats.json)

# Processor
SIMILARITY_THRESHOLD=0.85
CONSUMER_NAME=processor-1
BATCH_SIZE=256                         # Pipeline batch size (256 recommended)
PREFETCH_SIZE=1024                     # Redis read-ahead buffer
EMBEDDING_DEVICE=                      # auto (cuda if available, else cpu)
EMBEDDING_BATCH_SIZE=                  # auto (64 CPU, 256 GPU)
BACKPRESSURE_THRESHOLD=50000           # Queue depth to signal scrapers to throttle
METRICS_INTERVAL=10                    # Seconds between throughput logs
WRITE_POOL_MIN=10                      # Listing UPSERT pool
WRITE_POOL_MAX=30
COPY_POOL_MIN=2                        # COPY protocol pool (price_history)
COPY_POOL_MAX=5
WRITE_FLUSH_SIZE_MIN=256               # Adaptive batch: min rows per flush
WRITE_FLUSH_SIZE_MAX=1024              # Adaptive batch: max rows per flush
WRITE_FLUSH_INTERVAL_MS=75             # Max ms between flushes
WRITE_TARGET_LATENCY_MS=25             # Adaptive: increase batch below this
WRITE_MAX_LATENCY_MS=50                # Adaptive: decrease batch above this
MEDIAN_REFRESH_INTERVAL=300            # Seconds between median updates (deferred)
DB_SYNC_COMMIT=off                     # off = async WAL (~3x faster commits)
READ_POOL_MIN=2                        # Read-only DB pool (index refresh, cache warmup)
READ_POOL_MAX=5
HNSW_EF_SEARCH=100                     # HNSW search quality (still used for legacy path)
MATCH_CACHE_SIZE=16384                 # In-memory LRU cache for resolved titles
INDEX_REFRESH_INTERVAL=120             # Seconds between full product index refresh
PROCESSOR_MODE=pipeline                # pipeline (high-throughput) or legacy

# API
TELEGRAM_BOT_TOKEN=
ROI_ALERT_THRESHOLD=0.20
ALLOWED_ORIGINS=http://localhost:4200,http://localhost
API_KEY=

# Opportunity Engine Thresholds
MIN_PROFIT_USD=5
MAX_ROI=1.5
MIN_SELLER_RATING=2.5

# Shadow mode (set to true during validation period)
SHADOW_MODE=true

# Health alerter
HEALTH_ALERT_INTERVAL=60
HEALTH_ALERT_THRESHOLD=3
HEALTH_TELEGRAM_CHAT_ID=

# Execution Engine
MAX_TOTAL_EXPOSURE=10000             # Max total open capital (USD)
MAX_SINGLE_ORDER=2000                # Max capital per single trade
MAX_DAILY_ORDERS=50                  # Max orders per day
EXECUTION_MIN_ROI=0.05               # Minimum ROI for execution (5%)
EXECUTION_MIN_PROFIT=5.0             # Minimum profit per trade (USD)
AUTO_APPROVE_MAX_COST=50             # Auto-approve orders below this cost
AUTO_APPROVE_MIN_CONFIDENCE=0.7      # Min confidence for auto-approval
